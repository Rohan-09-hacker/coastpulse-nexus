# Server Runtime Environment
# Set to "production" when running `npm start` after `npm run build`
NODE_ENV="development"

# GEMINI_API_KEY: Optional for offline/simulated demo mode; required for live Gemini API calls.
# Never expose this key in client-side code.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional BYOK Provider Keys (Server-Side Only)
# OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
# ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"

# APP_URL: Public URL where the application is hosted (used for callbacks/metadata).
APP_URL="http://localhost:3000"
